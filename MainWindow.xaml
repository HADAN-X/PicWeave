<Window x:Class="PicWeave.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PicWeave · 图片拼接" Height="810" Width="1160" MinHeight="700" MinWidth="950"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB" AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,9"/></Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="13" Background="#635BFF" Margin="0,0,12,0">
                    <TextBlock Text="▧" Foreground="White" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel><TextBlock Text="PicWeave" FontSize="21" FontWeight="Bold"/><TextBlock Text="简单拼接，让每张照片连在一起" FontSize="12" Foreground="#8290A4" Margin="0,2,0,0"/></StackPanel>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EDEBFF" CornerRadius="15" Padding="10,5">
                <TextBlock Text="●  在本机处理" FontSize="11" Foreground="#5D55DD"/>
            </Border>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="18" Padding="20" BorderBrush="#EAEDF3" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="15"/><RowDefinition Height="*"/><RowDefinition Height="15"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0"><StackPanel><TextBlock Text="输入图片" FontSize="16" FontWeight="Bold"/><TextBlock x:Name="ImageCountText" Text="添加图片开始拼接" FontSize="12" Foreground="#8290A4" Margin="0,4,0,0"/></StackPanel>
                        <Button Grid.Column="1" Content="＋ 添加图片" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,8" Click="AddImages_Click" Background="#F2F1FF" BorderBrush="#E4E2FF" Foreground="#5148D9" FontWeight="SemiBold"/>
                    </Grid>
                    <Border Grid.Row="2" BorderBrush="#DDDFF3" BorderThickness="1" Background="#FAFAFF" CornerRadius="12" Padding="12">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="↕" Foreground="#635BFF" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="拖放图片到这里，可一次添加多张" Foreground="#68758A" FontSize="12" VerticalAlignment="Center"/></StackPanel>
                    </Border>
                    <ListBox x:Name="ImageList" Grid.Row="4" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" AllowDrop="True" Drop="ImageList_Drop" DragOver="Window_DragOver" SelectionChanged="ImageList_SelectionChanged">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Border Background="#FBFCFE" BorderBrush="#EDF0F5" BorderThickness="1" CornerRadius="11" Padding="9">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="49"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="49" Height="49" CornerRadius="8" ClipToBounds="True" Background="#ECEFF5"><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/></Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Dimensions}" FontSize="11" Foreground="#8290A4" Margin="0,4,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="↑" Padding="7,5" Margin="0,0,4,0" ToolTip="上移" Click="MoveUp_Click"/>
                                        <Button Content="↓" Padding="7,5" Margin="0,0,4,0" ToolTip="下移" Click="MoveDown_Click"/>
                                        <Button Content="×" Padding="8,5" Foreground="#AF6570" ToolTip="移除" Click="Remove_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate></ListBox.ItemTemplate>
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    </ListBox>
                    <StackPanel Grid.Row="6"><Border Height="1" Background="#EDF0F5" Margin="0,0,0,13"/>
                        <TextBlock Text="快速操作" Style="{StaticResource SectionTitle}"/>
                        <Button Content="清空所有图片" HorizontalAlignment="Left" Padding="10,6" Foreground="#8A6570" Click="ClearImages_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="18" Padding="23" BorderBrush="#EAEDF3" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="15"/><RowDefinition Height="Auto"/><RowDefinition Height="17"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"><TextBlock Text="拼接设置" FontSize="16" FontWeight="Bold"/><TextBlock Text="选择方向和每张图片的对齐尺寸" FontSize="12" Foreground="#8290A4" Margin="0,4,0,0"/></StackPanel>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="拼接方向" Style="{StaticResource SectionTitle}"/><ComboBox x:Name="DirectionCombo" SelectionChanged="Settings_Changed"><ComboBoxItem Content="纵向拼接 · 从上到下" IsSelected="True"/><ComboBoxItem Content="横向拼接 · 从左到右"/></ComboBox></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="尺寸基准" Style="{StaticResource SectionTitle}"/><ComboBox x:Name="SizeCombo" SelectionChanged="Settings_Changed"><ComboBoxItem Content="第一张图片尺寸" IsSelected="True" Tag="first"/><ComboBoxItem Content="自定义尺寸" Tag="custom"/></ComboBox></StackPanel>
                    </Grid>
                    <Border Grid.Row="4" Background="#F8F9FC" CornerRadius="13" Padding="16">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0"><StackPanel><TextBlock Text="尺寸基准" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="SizeDescription" Text="所有图片按第一张图片的尺寸对齐" FontSize="11" Foreground="#8290A4" Margin="0,3,0,0"/></StackPanel>
                                <StackPanel x:Name="SizePickerPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ComboBox x:Name="ReferenceCombo" Width="220" SelectionChanged="Settings_Changed" DisplayMemberPath="Name"/>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="2" VerticalAlignment="Top">
                                <Grid x:Name="CustomSizePanel" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="宽度 (px)" Style="{StaticResource SectionTitle}"/><TextBox x:Name="WidthBox" Text="1200" TextChanged="Settings_Changed"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="高度 (px)" Style="{StaticResource SectionTitle}"/><TextBox x:Name="HeightBox" Text="800" TextChanged="Settings_Changed"/></StackPanel>
                                </Grid>
                                <StackPanel x:Name="ImageSizeInfo" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0"><Border Width="33" Height="33" CornerRadius="10" Background="#ECEAFF" Margin="0,0,10,0"><TextBlock Text="▤" Foreground="#635BFF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock x:Name="CurrentSizeText" Text="等待添加图片" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="每张图片按相同尺寸拼接" FontSize="11" Foreground="#8290A4" Margin="0,3,0,0"/></StackPanel></StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="图片填充" FontSize="12" FontWeight="SemiBold" Margin="0,0,12,0"/><ComboBox x:Name="FitCombo" Width="195" SelectionChanged="Settings_Changed"><ComboBoxItem Content="完整显示 · 留白补齐" IsSelected="True"/><ComboBoxItem Content="铺满画布 · 裁切边缘"/><ComboBoxItem Content="拉伸铺满"/></ComboBox></StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="输出格式" FontSize="11" Foreground="#8290A4"/><ComboBox x:Name="FormatCombo" Width="125" HorizontalAlignment="Left" Margin="0,5,0,0"><ComboBoxItem Content="PNG · 无损" IsSelected="True"/><ComboBoxItem Content="JPEG · 高质量"/></ComboBox></StackPanel>
                        <Button Grid.Column="1" Content="预览拼接" VerticalAlignment="Bottom" Click="Preview_Click" Padding="17,11"/>
                        <Button x:Name="SaveButton" Grid.Column="3" Content="拼接并保存  →" Background="#635BFF" Foreground="White" BorderBrush="#635BFF" FontWeight="SemiBold" Padding="20,12" VerticalAlignment="Bottom" Click="Save_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="4" Text="PicWeave  ·  图片仅在本地处理，不会上传" FontSize="11" Foreground="#98A2B3" HorizontalAlignment="Center"/>
        <Border x:Name="PreviewOverlay" Grid.RowSpan="5" Background="#9C17202E" Visibility="Collapsed" MouseDown="PreviewOverlay_MouseDown">
            <Border Background="White" CornerRadius="18" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="760" Height="590" MouseDown="PreviewCard_MouseDown">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel><StackPanel><TextBlock Text="拼接预览" FontSize="16" FontWeight="Bold"/><TextBlock x:Name="PreviewDimensions" Text="" FontSize="11" Foreground="#8290A4" Margin="0,3,0,0"/></StackPanel><Button Content="×" DockPanel.Dock="Right" Padding="9,5" Click="ClosePreview_Click"/></DockPanel>
                    <Border Grid.Row="2" Background="#F1F3F7" CornerRadius="10" Padding="12"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Image x:Name="PreviewImage" Stretch="Uniform"/></ScrollViewer></Border>
                    <Button Grid.Row="4" Content="完成并保存图片  →" Background="#635BFF" Foreground="White" BorderBrush="#635BFF" HorizontalAlignment="Right" Padding="18,10" Click="Save_Click"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
