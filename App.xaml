<Application x:Class="PicWeave.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1C2635" />
        <SolidColorBrush x:Key="Muted" Color="#8290A4" />
        <SolidColorBrush x:Key="Accent" Color="#635BFF" />
        <SolidColorBrush x:Key="Line" Color="#E9EDF3" />
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#E5E8EF"/>
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#303A4C"/>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
        <Style TargetType="ComboBox"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="8,7"/><Setter Property="MinHeight" Value="38"/></Style>
        <Style TargetType="TextBox"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#E5E8EF"/><Setter Property="BorderThickness" Value="1"/></Style>
    </Application.Resources>
</Application>
